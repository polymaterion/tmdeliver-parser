  "date_patterns": [
    {"name": "numeric_full", "kind": "exact", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d)[./-](?P<month>[01]?\\d)[./-](?P<year>\\d{4}|\\d{2})(?!\\d)"},
    {"name": "numeric_space", "kind": "exact", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d) (?P<month>[01]?\\d) (?P<year>20\\d{2}|\\d{3})(?!\\d)"},
    {"name": "day_month_name", "kind": "exact", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d)(?:-(?P<day2>[0-3]?\\d))?(?: (?:ne|na|nji|nci|inji|nde|de|da|ni|sine|ine|aga|ga|ci|nca|e|a|i|u))?(?: (?:cisla|cislo|cisle))? {MONTH}"},
    {"name": "month_day", "kind": "exact", "regex": "{MONTH}(?: ain)? (?P<day>[0-3]?\\d)(?![\\d./-])"},
    {"name": "this_month_day", "kind": "day_only", "regex": "(?<![a-z])ain (?P<day>[0-3]?\\d)(?![\\d./-])"},
    {"name": "numeric_short", "kind": "exact", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d)[./-](?P<month>[01]?\\d)(?!\\d)(?! ?kg)"},
    {"name": "numeric_start", "kind": "exact", "regex": "^(?P<day>[0-3]?\\d) (?P<month>[01]?\\d)(?= [a-z])"},
    {"name": "day_chisla", "kind": "day_only", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d) (?:cisla|cislo)"},
    {"name": "day_only", "kind": "day_only", "regex": "(?<![\\d./-])(?P<day>[0-3]?\\d) ?(?:ne|na|nji|nci|sine|ine|nde|aga|ga)(?![a-z])"}
  ],
